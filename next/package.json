    "platformatic": "^3.39.0",
    "pm2": "^6.0.0",
    "@platformatic/ssrt-react": "19.3.0-ssrt.2",
    "@platformatic/ssrt-react-dom": "19.3.0-ssrt.2",
    "@platformatic/ssrt-react-is": "19.3.0-ssrt.2",
    "@platformatic/ssrt-react-server-dom-turbopack": "19.3.0-ssrt.2",
    "@platformatic/ssrt-react-server-dom-webpack": "19.3.0-ssrt.2",
    "@platformatic/ssrt-scheduler": "0.28.0-ssrt.2",
    "react": "npm:@platformatic/ssrt-react@19.3.0-ssrt.2",
    "react-dom": "npm:@platformatic/ssrt-react-dom@19.3.0-ssrt.2",
    "react-is": "npm:@platformatic/ssrt-react-is@19.3.0-ssrt.2",
    "react-server-dom-turbopack": "npm:@platformatic/ssrt-react-server-dom-turbopack@19.3.0-ssrt.2",
    "react-server-dom-webpack": "npm:@platformatic/ssrt-react-server-dom-webpack@19.3.0-ssrt.2",
    "scheduler": "npm:@platformatic/ssrt-scheduler@0.28.0-ssrt.2",
    "wattpm": "^3.39.0"
  },
  "devDependencies": {
    "@platformatic/flame": "^1.4.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@platformatic/ssrt-babel-plugin-react-compiler": "0.0.0-experimental-ssrt.2",
    "tailwindcss": "^4",
