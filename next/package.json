{
  "name": "next",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_ENV=production next build && echo '[]' > .next/dynamic-css-manifest && echo '{}' > .next/server/subresource-integrity-manifest.json",
    "build:control": "TEMPLATES=0 npm run build",
    "build:ssrt": "TEMPLATES=1 npm run build",
    "start": "NODE_ENV=production next start",
    "start:node": "NODE_ENV=production next start",
    "start:watt": "NODE_ENV=production wattpm start",
    "start:pm2r": "NODE_ENV=production pm2 start ecosystem.config.js && pm2 monitor"
  },
  "dependencies": {
    "@platformatic/next": "^3.39.0",
    "@platformatic/runtime": "^3.39.0",
    "@platformatic/watt-extra": "^1.10.0",
