{
  "$schema": "https://schemas.platformatic.dev/@platformatic/tanstack/3.29.1.json",
  "application": {
    "outputDirectory": ".output"
  },
  "runtime": {
    "logger": {
      "level": "{LOG_LEVEL}"
    },
    "verticalScaler": {
      "enabled": false
    },
    "server": {
      "hostname": "{HOSTNAME}",
      "port": "{PORT}",
      "backlog": "{BACKLOG}"
    },
    "metrics": {
      "enabled": "{PLT_SERVER_METRICS}"
    },
    "health": {
      "enabled": "{PLT_SERVER_HEALTH}",
      "interval": 5000,
      "maxUnhealthyChecks": 3,
      "maxHeapTotal": "4GB",
      "maxYoungGeneration": "128MB"
    },
    "managementApi": true,
    "gracefulShutdown": {
      "runtime": 1000,
      "application": 1000
    },
    "workers": {
      "static": "{WORKERS}"
    }
  }
}
